# --- Database (cloud-hosted MySQL 8 / MariaDB 10.6+) ---
DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=shop
DB_PASSWORD=change-me
DB_NAME=shopdb
# Set to true if your cloud MySQL requires TLS
DB_SSL=false
# Provider CA certificate (paste the full ca.pem text) if the host uses its own CA, e.g. Aiven
DB_SSL_CA=

# --- App ---
PORT=3000
SESSION_SECRET=replace-with-a-long-random-string
APP_TZ=Asia/Dhaka
# Password for the first admin account (only used when the users table is empty)
ADMIN_PASSWORD=admin123

# --- HTTPS (pick one) ---
# A) Behind a reverse proxy / platform that terminates TLS (Nginx, Caddy, Railway, Render...):
TRUST_PROXY=false
# B) Serve HTTPS directly from Node:
# TLS_CERT=/path/to/fullchain.pem
# TLS_KEY=/path/to/privkey.pem

# --- Vercel ---
# Protects the daily archive cron endpoint (/api/cron/archive). Vercel sends it automatically.
CRON_SECRET=replace-with-a-random-string
